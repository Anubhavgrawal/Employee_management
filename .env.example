NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:12345678@localhost:5432/employee_management
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_ISSUER=employee-management-api
JWT_AUDIENCE=employee-management-clients
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
AUDIT_RETENTION_DAYS=365
COOKIE_SECURE=false
